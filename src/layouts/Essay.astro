---
import Base from './Base.astro';
import { PILLARS, SITE } from '../data/site';

interface Props {
  /** The essay's number, 01–03. Omitted on project pages, which reuse this layout. */
  docNo?: string;
  title: string;
  description: string;
  /**
   * One-sentence thesis shown large under the title. Defaults to this essay's
   * `promise` in site.ts, which is the same sentence the home page prints, so
   * the two can never drift apart. Only pass it to deliberately differ.
   */
  thesis?: string;
  /**
   * Where the closing card leads. Only pages outside the essay series pass
   * it (the project pages); the essays work it out from their order.
   */
  next?: { href: string; kicker: string; title: string; promise: string };
  /** Passed through to Base: this page's own link-preview card. */
  social?: { image: ImageMetadata; alt: string };
}

const { docNo, title, description, thesis, next: nextOverride, social } = Astro.props;

// The essays read in order. The last one hands the reader to the person who
// wrote them, rather than looping back to the first essay.
const here = PILLARS.findIndex((p) => p.no === docNo);
const isLast = here === PILLARS.length - 1;
const next =
  nextOverride ??
  (isLast
    ? {
        href: '/about',
        kicker: 'Next · About',
        title: 'About Flora',
        promise: 'Experience, education, and what I do beyond the job.',
      }
    : { ...PILLARS[here + 1], kicker: `Next · ${PILLARS[here + 1].no}` });
const thesisText = thesis ?? PILLARS[here]?.promise ?? '';
---

<Base title={title} description={description} docNo={docNo} social={social} article>
  <article class="essay shell shell--read">
    <header class="essay__head">
      <h1 class="page-title">{title}</h1>
      <p class="essay__thesis">{thesisText}</p>
    </header>

    <div class="essay__body">
      <slot />
    </div>

    <footer class="essay__end">
      <a class="nextup" href={next.href}>
        <span class="label nextup__kicker">{next.kicker}</span>
        <span class="nextup__title">{next.title}</span>
        <span class="nextup__promise">{next.promise}</span>
      </a>

      {/* The invitation closes the series once, not every essay. */}
      {isLast && (
        <div class="essay__cta">
          <p>
            If any of this is useful to your team, I am glad to talk it through. I speak at career
            talks, student sessions and community events.
          </p>
          <p class="essay__ctalinks">
            <a href="/speaking">What I can talk about</a>
            <span aria-hidden="true">·</span>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
      )}
    </footer>
  </article>
</Base>

<style is:global>
  /* On the reading spine (shell--read) so the column reads as a deliberate
     document block, left-aligned with the page masthead above it. */
  .essay {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  /* Smaller than the site h1 so the longest essay title, "How a product
     earns confidence", holds one line on desktop. */
  .essay__head h1 {
    font-size: clamp(2.25rem, 4.6vw, 3.125rem);
  }

  .essay__head {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .essay__thesis {
    margin-top: 1.25rem;
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    line-height: 1.45;
    color: var(--ink-muted);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .essay__body {
    padding-top: 1rem;
  }

  /* Prose fills the reading spine, edge to edge with the section rules,
     instead of stopping at the global 44rem measure: on the essay pages
     that left a strip of empty column beside every paragraph. */
  .essay__body p,
  .essay__body ul {
    max-width: none;
  }

  /* numbered subsection inside an essay */
  .sub {
    padding-block: clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }

  .sub:last-child {
    border-bottom: 0;
  }

  .sub__head {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1.1rem;
  }

  .sub__no {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--accent);
    flex: none;
    padding-top: 0.3em;
    letter-spacing: 0.08em;
  }

  .sub h2 {
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
  }

  .sub__body {
    padding-left: 0;
  }

  /* Reading path: never end an essay in the footer. */
  .essay__end {
    margin-top: 3rem;
    border-top: 1px solid var(--rule-strong);
  }

  .nextup {
    display: block;
    padding: 1.5rem 1.5rem 1.6rem;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    border-top: 0;
    text-decoration: none;
    color: inherit;
    transition: background 120ms ease;
  }

  .nextup:hover {
    background: color-mix(in srgb, var(--accent) 8%, var(--paper-sunk));
  }

  .nextup__kicker {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }

  .nextup__title {
    display: block;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 0.22em;
  }

  .nextup:hover .nextup__title {
    text-decoration-color: var(--accent);
  }

  .nextup__promise {
    display: block;
    margin-top: 0.6rem;
    max-width: 58ch;
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }

  .essay__cta {
    padding-top: 2rem;
  }

  .essay__cta p {
    max-width: 56ch;
  }

  .essay__ctalinks {
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .pullquote {
    margin: 1.75rem 0;
    padding: 1.1rem 1.35rem;
    border-left: 2px solid var(--accent);
    background: var(--paper-sunk);
    font-size: var(--fs-lede);
  }

  .pullquote p:last-child {
    margin-bottom: 0;
  }

  /* The question an essay opens with, set a step above body text. */
  .opener {
    font-size: var(--fs-lede);
    font-weight: 600;
    color: var(--ink);
  }

  /* Sources and repo links: present, but below the argument. */
  .aside {
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }

  .essay__body ul {
    padding-left: 1.15rem;
  }

  .essay__body li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 640px) {
    .sub__head {
      gap: 0.7rem;
    }
  }
</style>
