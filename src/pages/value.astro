          <text class="chart__note" x="420" y="74" text-anchor="middle">Cost committed</text>
          <text class="chart__note" x="610" y="200" text-anchor="end">Cost incurred</text>

          <g text-anchor="middle">
            <text class="chart__tick" x="120" y="272">Concept</text>
            <text class="chart__tick" x="253" y="272">Design</text>
            <text class="chart__tick" x="407" y="272">EVT · DVT</text>
