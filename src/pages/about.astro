---
import Base from '../layouts/Base.astro';
import DraftNote from '../components/DraftNote.astro';
import Entry from '../components/Entry.astro';
import { Image } from 'astro:assets';
import { SITE, EXPERIENCE, EDUCATION, SKILLS, PROJECTS, CERTS } from '../data/site';
import headshot from '../assets/headshot.jpg';
import tsmcBooth from '../assets/tsmc-ambassador-booth.jpg';
import gtcTaipei from '../assets/gtc-taipei-2026.jpg';
import compass from '../assets/compass-fellowship.jpg';


/* Section order follows what a recruiter reads first: the record
   (experience, education), then what she can do (skills, certifications),
   then what she does beyond the job (ambassador work, events), and last the
   repositories, which are the most detailed and least often read. */
---

<Base
  title="About"
  description="Flora Liu, hardware engineer at Amazon, working across hardware development, NPI and AI-assisted engineering workflows. Experience, education, skills, certifications and selected work."
  docNo="05"
>
  <div class="shell about">
    <!-- ---------- who ---------- -->
    <section class="intro">
      <div class="intro__lead">
        <h1>About</h1>
        <p class="intro__lede">
          I am Flora Liu, a hardware engineer at Amazon, working on the product integrity side of NPI.
        </p>
      </div>

      <!-- Condensed from four paragraphs. The three seats are set like the
           GTC formula below, each with the role it plays, so the middle of the
           story reads at a glance; the sentences around it keep the voice. -->
      <div class="intro__body">
        <p>
          Mechanical engineering gave me the physics. Testing, product development and research taught
          me to turn it into data, then decisions. That turned out to be the harder half.
        </p>
        <ol class="list-plain seats" aria-label="Three seats on the same supply chain">
          <li><span class="seats__org">SGS</span><span class="seats__verb">produces evidence</span></li>
          <li><span class="seats__org">Delta</span><span class="seats__verb">builds and pushes back</span></li>
          <li><span class="seats__org">Amazon</span><span class="seats__verb">decides and lives with it</span></li>
        </ol>
        <p>I write about what happens in between, because almost nobody writes that down.</p>
        <p>
          Now: turning hardware evidence into decisions the business can act on, and using agents to cut
          coordination friction without handing over the judgement.
        </p>
      </div>

      <div class="intro__aside">
        <Image
          class="intro__photo"
          src={headshot}
          alt="Portrait of Flora Liu."
          widths={[320, 640]}
          sizes="(max-width: 800px) 60vw, 20rem"
          loading="eager"
        />
        <!-- The spot under the photo is the most-seen place on the page after
             the headline, so it holds what a recruiter acts on: ways to reach
             her, not facts the page already states. -->
        <a class="btn btn--primary intro__resume" href={SITE.resume} target="_blank" rel="noopener">
          Download résumé (PDF)
        </a>
        <ul class="list-plain intro__links">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn →</a></li>
          <li><a href={SITE.github} target="_blank" rel="me noopener">GitHub →</a></li>
        </ul>
      </div>
    </section>

    <nav class="contents" aria-label="On this page">
      <p class="label contents__title">Contents</p>
      <ol class="list-plain contents__list">
        <li><span class="num">5.1</span> <a href="#experience">Experience</a></li>
        <li><span class="num">5.2</span> <a href="#education">Education</a></li>
        <li><span class="num">5.3</span> <a href="#skills">Skills</a></li>
        <li><span class="num">5.4</span> <a href="#certifications">Certifications &amp; training</a></li>
        <li><span class="num">5.5</span> <a href="#outside">Outside the lab</a></li>
        <li><span class="num">5.6</span> <a href="#work">Selected work</a></li>
      </ol>
    </nav>

    <!-- ---------- the record ---------- -->
    <section class="section" id="experience">
      <div class="section-head">
        <span class="section-head__num">5.1</span>
        <h2>Experience</h2>
      </div>

      <div class="entries">
        {
          EXPERIENCE.map((job) => (
            <Entry logo={job.logo} heading={job.org} sub={job.title} period={job.period}>
              {job.note && <p class="num exp__note">{job.note}</p>}
              <ul>
                {job.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </Entry>
          ))
        }
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-head">
        <span class="section-head__num">5.2</span>
        <h2>Education</h2>
      </div>

      <div class="entries">
        {
          EDUCATION.map((e) => (
            <Entry logo={e.logo} heading={e.school} sub={e.degree} period={e.period}>
              <p>{e.detail}</p>
              {e.paper && (
                <p class="edu__paper">
                  <a href={e.paper.href} target="_blank" rel="noopener">
                    {e.paper.label} ↗
                  </a>
                </p>
              )}
            </Entry>
          ))
        }
      </div>
    </section>

    <section class="section" id="skills">
      <div class="section-head">
        <span class="section-head__num">5.3</span>
        <div>
          <h2>Skills</h2>
        </div>
      </div>

      <dl class="skills">
        {
          SKILLS.map((s) => (
            <div class="skills__row">
              <dt class="skills__area">{s.area}</dt>
              <dd class="skills__items">
                {s.items.map((item, i) => (
                  <>
                    {i > 0 && <span class="skills__sep" aria-hidden="true"> · </span>}
                    <span class="skills__item">{item}</span>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" id="certifications">
      <div class="section-head">
        <span class="section-head__num">5.4</span>
        <h2>Certifications &amp; training</h2>
      </div>

      {
        [
          { tier: 'cert', label: 'Certifications' },
          { tier: 'training', label: 'Training' },
        ].map((g) => (
          <>
            <h3 class="certs__group">{g.label}</h3>
            <div class="entries certs">
              {CERTS.filter((c) => c.tier === g.tier).map((c) => (
                <Entry
                  logo={c.logo}
                  heading={c.name}
                  href={c.url}
                  sub={c.issuer}
                  period={c.date}
                  compact
                />
              ))}
            </div>
          </>
        ))
      }
    </section>

    <section class="section" id="outside">
      <div class="section-head">
        <span class="section-head__num">5.5</span>
        <h2>Outside the lab</h2>
      </div>
      <p>
        Beyond the day job: representing TSMC on campus, hearing where the industry is heading, and
        working through problems with people from other fields.
      </p>

      <article class="side">
        <div class="side__text">
          <h3>TSMC Campus Ambassador, National Taiwan University</h3>
          <p class="side__meta num">Mar 2025–Mar 2026</p>
          <p>
            Represented TSMC at NTU job fairs and recruiting sessions, and wrote the event posts. The
            job-fair post:
          </p>
          <dl class="side__stats">
            <div>
              <dt>Impressions</dt>
              <dd class="num">11,000+</dd>
            </div>
            <div>
              <dt>Reactions</dt>
              <dd class="num">370+</dd>
            </div>
            <div>
              <dt>Comments</dt>
              <dd class="num">90+</dd>
            </div>
          </dl>
          <p class="side__note">
            Impressions: LinkedIn only. Reactions and comments: LinkedIn and Facebook.
            <a
              href="https://www.linkedin.com/feed/update/urn:li:activity:7308291229178376193/"
              target="_blank"
              rel="noopener">Read the post ↗</a
            >
          </p>
        </div>
        <Image
          src={tsmcBooth}
          alt="Flora at the TSMC booth during the NTU job fair, talking with a student."
          widths={[320, 640, 960]}
          sizes="(max-width: 44rem) 100vw, 16rem"
          loading="lazy"
          class="side__photo"
        />
      </article>

      <article class="side side--landscape">
        <div class="side__text">
          <h3>NVIDIA GTC Taipei 2026</h3>
          <p class="side__meta num">Jun 2026 · Taipei Music Center</p>
          <p>From Jensen Huang's keynote:</p>
          <p class="side__formula">Agent = LLM + Harness</p>
          <p>
            The agent is the application, the LLM is the code, the harness is the operating system.
            To build agents, we need LLMs that write code inside that operating system.
          </p>
          <p class="side__note">
            <a
              href="https://www.nvidia.com/en-us/on-demand/session/gtctaipei26-stw61044/"
              target="_blank"
              rel="noopener">Watch the keynote ↗</a
            >
            ·
            <a href="https://www.nvidia.com/en-tw/gtc/taipei/" target="_blank" rel="noopener"
              >About GTC Taipei ↗</a
            >
          </p>
        </div>
        <Image
          src={gtcTaipei}
          alt="Flora's NVIDIA GTC 2026 Taipei badge held up in front of the keynote stage."
          widths={[320, 640]}
          sizes="(max-width: 44rem) 100vw, 16rem"
          loading="lazy"
          class="side__photo"
        />
      </article>

      <article class="side side--landscape">
        <div class="side__text">
          <h3>Compass Fellowship</h3>
          <p class="side__meta num">Jan 2026 · Taipei</p>
          <p>
            A five-day live-in fellowship, run in partnership with
            <a href="https://www.sparklabstaiwan.com/" target="_blank" rel="noopener"
              >SparkLabs Taiwan</a
            >. Workshops on
            modelling the world accurately, examining one's own values, and executing on them, led by
            instructors from Harvard, MIT and Google.
          </p>
          <p class="side__note">
            <a href="https://compassfellowship.app/" target="_blank" rel="noopener"
              >About the fellowship ↗</a
            >
          </p>
        </div>
        <Image
          src={compass}
          alt="A small-group workshop at Compass Fellowship, sketching ideas on a shared sheet."
          widths={[320, 640]}
          sizes="(max-width: 44rem) 100vw, 16rem"
          loading="lazy"
          class="side__photo"
        />
      </article>

      <DraftNote
        needs="One honest paragraph about what you are reading, learning, or arguing about lately. This does more for a personal site than another list of tools — your 19,000-impression LinkedIn post was written in exactly this register."
      />
    </section>

    <section class="section" id="work">
      <div class="section-head">
        <span class="section-head__num">5.6</span>
        <div>
          <h2>Selected work</h2>
          <p class="section-head__sub">
            Public repositories. Work done at Amazon is not represented here and will not be. What I
            can share about it lives in the written pages instead.
          </p>
        </div>
      </div>

      <!-- Same layout as "Outside the lab": text and figures on the left,
           the repo's README images on the right. -->
      {
        PROJECTS.map((p) => (
          <article class:list={['side', !p.media && 'side--solo']}>
            <div class="side__text">
              <div class="proj__head">
                <h3>{p.title}</h3>
                <span class="chip">{p.kind}</span>
              </div>
              <p>{p.summary}</p>
              {p.stats && (
                <dl class="side__stats">
                  {p.stats.map((st) => (
                    <div>
                      <dt>{st.label}</dt>
                      <dd class="num">{st.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <p class="side__note">
                <a class="proj__repo" href={`${SITE.github}/${p.repo}`} target="_blank" rel="noopener">
                  github.com/liu092111/{p.repo} ↗
                </a>
              </p>
            </div>
            {p.media && (
              <div class:list={['proj__media', p.media.length >= 3 && 'proj__media--grid']}>
                {p.media.map((m) => (
                  <img src={m.src} alt={m.alt} loading="lazy" decoding="async" />
                ))}
              </div>
            )}
          </article>
        ))
      }
    </section>
  </div>
</Base>

<style>
  /* Desktop: prose left, photo right. Phones collapse to source order —
     name and role first, then the photo, then the rest — so the page opens
     with who she is rather than with a portrait. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    grid-template-areas: 'lead aside' 'body aside';
    /* The photo column is taller than the text; the spare height goes to
       the body row, so the lede and the seats stay together. */
    grid-template-rows: auto 1fr;
    gap: 0 clamp(2rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-bottom: 1rem;
    align-items: start;
  }

  .intro__lead {
    grid-area: lead;
  }

  .intro__body {
    grid-area: body;
  }

  .intro__aside {
    grid-area: aside;
  }

  /* SGS → Delta → Amazon, each seat's verb under its name. The arrows are
     decoration; the list order already carries the sequence. */
  .seats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 1.75rem 0 2rem;
    font-family: var(--font-mono);
  }

  .seats li {
    display: flex;
    flex-direction: column;
  }

  .seats li + li::before {
    content: '→';
    position: absolute;
    margin-left: -1.6rem;
    font-size: var(--fs-lede);
    color: var(--ink-muted);
  }

  .seats li + li {
    position: relative;
    padding-left: 1.6rem;
  }

  .seats__org {
    font-size: var(--fs-lede);
    font-weight: 600;
    color: var(--accent);
  }

  /* Wraps to two short lines, so the three columns stay narrow. */
  .seats__verb {
    max-width: 8.5rem;
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .intro__lede {
    margin-top: 1.25rem;
    font-size: var(--fs-lede);
  }

  .intro h1 {
    margin-bottom: 0;
  }

  .intro__photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }

  /* The one action a recruiter on this page most wants, so it is the one
     filled button, directly under the photo. */
  .intro__resume {
    width: 100%;
    margin-bottom: 1rem;
  }

  .intro__links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* A side activity: text and its photo together, so the numbers sit next to
     the day they came from. The photo is supporting, not the subject, so it
     stays in a narrow column rather than taking the text measure. */
  .side {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
    margin: 2rem 0;
    max-width: 60rem;
  }

  /* Same light hairline as every other item on the page (entries, skills,
     projects); the dark rule is reserved for numbered sections. */
  .side + .side {
    border-top: 1px solid var(--rule);
    padding-top: 2rem;
  }

  /* A landscape photo is much shorter than its text; centring it on the
     text block keeps it from hanging off the top corner. */
  .side--landscape {
    align-items: center;
  }

  .side__formula {
    font-family: var(--font-mono);
    font-size: var(--fs-lede);
    font-weight: 600;
    color: var(--accent);
    margin: 0.5rem 0 1rem;
  }

  .side h3 {
    margin: 0;
  }

  .side__meta {
    margin: 0.25rem 0 1rem;
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }

  .side__photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .side__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 1rem 0;
  }

  .side__stats dt {
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }

  .side__stats dd {
    margin: 0;
    font-size: var(--fs-lede);
    font-weight: 600;
    color: var(--accent);
  }

  .side__note {
    font-size: var(--fs-meta);
    color: var(--ink-muted);
  }

  .side__note a {
    white-space: nowrap;
  }

  @media (max-width: 44rem) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }

    .side__photo {
      max-width: 20rem;
    }
  }

  .section-head__sub {
    margin: 0.5rem 0 0;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  /* This is a reference page, not a landing page: tighter vertical rhythm
     than the essays so the whole record stays scannable. */
  .about :global(.section) {
    padding-block: clamp(2rem, 4.5vw, 3.25rem);
  }

  /* The contents block keeps a long page navigable. */
  .contents {
    margin-top: 2rem;
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius);
    background: var(--paper-sunk);
  }

  .contents__title {
    margin: 0 0 0.75rem;
  }

  .contents__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-size: var(--fs-small);
  }

  .contents__list li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  /* entries (experience, education, certifications) */
  .entries {
    max-width: 52rem;
  }

  .edu__paper {
    margin: 0.5rem 0 0;
    font-size: var(--fs-meta);
    font-weight: 600;
  }

  .exp__note {
    margin: 0.35rem 0 0;
  }

  /* Certifications are short: two columns on a wide screen. */
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    column-gap: 2.5rem;
    max-width: none;
  }

  .certs__group {
    margin: 1.5rem 0 0;
    font-size: var(--fs-meta);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .certs__group:first-of-type {
    margin-top: 0;
  }

  /* skills: area on the left, one readable line on the right */
  .skills {
    margin: 0;
    max-width: 52rem;
    border-top: 1px solid var(--rule);
  }

  .skills__row {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    gap: 0.35rem 1.5rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--rule);
  }

  .skills__area {
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .skills__items {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .skills__sep {
    color: var(--rule-strong);
  }

  /* projects */
  .proj__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  /* Repo URLs are long and have no spaces: unlike the other side notes,
     let them break on a phone instead of overflowing the page. */
  .side__note .proj__repo {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* A project with no README image uses the full text width. */
  .side--solo {
    grid-template-columns: minmax(0, 1fr);
  }

  /* The repo's README images in the right-hand column: one or two stack,
     three or more form a two-up grid of equal cells. */
  .proj__media {
    display: grid;
    gap: 0.5rem;
  }

  .proj__media--grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .proj__media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .proj__media--grid img {
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: var(--paper-sunk);
  }

  @media (max-width: 44rem) {
    .proj__media {
      max-width: 20rem;
    }
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
      grid-template-areas: 'lead' 'aside' 'body';
      gap: 1.5rem 0;
    }

    .intro__aside {
      max-width: 13rem;
    }
  }

  @media (max-width: 40rem) {
    .skills__row {
      grid-template-columns: 1fr;
    }

    .certs {
      grid-template-columns: 1fr;
    }
  }
</style>
