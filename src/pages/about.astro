---
import Base from '../layouts/Base.astro';
import DraftNote from '../components/DraftNote.astro';
import Entry from '../components/Entry.astro';
import { Image } from 'astro:assets';
import { SITE, EXPERIENCE, EDUCATION, SKILLS, PROJECTS, CERTS } from '../data/site';
import headshot from '../assets/headshot.jpg';

// Lead with the strongest; keep the rest available but out of the way.
const featured = PROJECTS.filter((p) => p.featured);
const rest = PROJECTS.filter((p) => !p.featured);

/* Section order follows what a recruiter reads first: the record
   (experience, education), then what she can do (skills, certifications),
   then evidence (work), and only then the personal. */
---

<Base
  title="About"
  description="Flora Liu, hardware engineer at Amazon, working across reliability, NPI and AI-assisted engineering workflows. Experience, education, skills, certifications and selected work."
  docNo="05"
>
  <div class="shell about">
    <!-- ---------- who ---------- -->
    <section class="intro">
      <div class="intro__lead">
        <h1>About</h1>
        <p class="intro__lede">
          I am Flora Liu, a hardware engineer at Amazon, working on the product integrity side of new
          product introduction.
        </p>
      </div>

      <div class="intro__body">
        <p>
          Mechanical engineering gave me a physical foundation. Reliability work, product development
          and research taught me to connect that foundation to data, and then to decisions. That
          turned out to be the harder half.
        </p>
        <p>
          I have been useful in three different seats: a third-party laboratory that produces
          evidence, a system company that builds and pushes back, and a global brand that has to
          decide and live with the consequence. I write because the interesting part of engineering is
          what happens in between, and almost nobody writes that down.
        </p>
        <p>
          Lately my curiosity goes into two things: making reliability evidence legible to the people
          who carry the business risk, and using agents to remove coordination friction in hardware
          development without handing over the judgement.
        </p>
      </div>

      <div class="intro__aside">
        <Image
          class="intro__photo"
          src={headshot}
          alt="Portrait of Flora Liu."
          widths={[320, 640]}
          sizes="(max-width: 800px) 60vw, 20rem"
          loading="eager"
        />
        <!-- The spot under the photo is the most-seen place on the page after
             the headline, so it holds what a recruiter acts on: ways to reach
             her, not facts the page already states. -->
        <ul class="list-plain intro__links">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn →</a></li>
          <li><a href={SITE.github} target="_blank" rel="me noopener">GitHub →</a></li>
        </ul>
      </div>
    </section>

    <nav class="contents" aria-label="On this page">
      <p class="label contents__title">Contents</p>
      <ol class="list-plain contents__list">
        <li><span class="num">5.1</span> <a href="#experience">Experience</a></li>
        <li><span class="num">5.2</span> <a href="#education">Education</a></li>
        <li><span class="num">5.3</span> <a href="#skills">Skills</a></li>
        <li><span class="num">5.4</span> <a href="#certifications">Certifications</a></li>
        <li><span class="num">5.5</span> <a href="#work">Selected work</a></li>
        <li><span class="num">5.6</span> <a href="#outside">Outside the lab</a></li>
      </ol>
    </nav>

    <!-- ---------- the record ---------- -->
    <section class="section" id="experience">
      <div class="section-head">
        <span class="section-head__num">5.1</span>
        <h2>Experience</h2>
      </div>

      <div class="entries">
        {
          EXPERIENCE.map((job) => (
            <Entry logo={job.logo} heading={job.org} sub={job.title} period={job.period}>
              {job.note && <p class="num exp__note">{job.note}</p>}
              <ul>
                {job.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </Entry>
          ))
        }
      </div>
    </section>

    <section class="section" id="education">
      <div class="section-head">
        <span class="section-head__num">5.2</span>
        <h2>Education</h2>
      </div>

      <div class="entries">
        {
          EDUCATION.map((e) => (
            <Entry logo={e.logo} heading={e.school} sub={e.degree} period={e.period}>
              <p>{e.detail}</p>
            </Entry>
          ))
        }
      </div>
    </section>

    <section class="section" id="skills">
      <div class="section-head">
        <span class="section-head__num">5.3</span>
        <div>
          <h2>Skills</h2>
          <p class="section-head__sub">
            Named specifically, because "statistical analysis" is a claim and these are checkable.
          </p>
        </div>
      </div>

      <dl class="skills">
        {
          SKILLS.map((s) => (
            <div class="skills__row">
              <dt class="skills__area">{s.area}</dt>
              <dd class="skills__items">
                {s.items.map((item, i) => (
                  <>
                    {i > 0 && <span class="skills__sep" aria-hidden="true"> · </span>}
                    <span class="skills__item">{item}</span>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="section" id="certifications">
      <div class="section-head">
        <span class="section-head__num">5.4</span>
        <h2>Certifications</h2>
      </div>

      <div class="entries certs">
        {
          CERTS.map((c) => (
            <Entry
              logo={c.logo}
              heading={c.name}
              href={c.url}
              sub={c.issuer}
              period={c.date}
              compact
            />
          ))
        }
      </div>
    </section>

    <section class="section" id="work">
      <div class="section-head">
        <span class="section-head__num">5.5</span>
        <div>
          <h2>Selected work</h2>
          <p class="section-head__sub">
            Public repositories. Work done at Amazon is not represented here and will not be. What I
            can share about it lives in the written pages instead.
          </p>
        </div>
      </div>

      {
        featured.map((p) => (
          <article class="proj">
            <div class="proj__head">
              <h3>{p.title}</h3>
              <span class="chip">{p.kind}</span>
            </div>
            <p class="proj__summary">{p.summary}</p>
            {p.detail && (
              <ul class="proj__detail">
                {p.detail.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            )}
            <p class="num">
              <a href={p.repo} target="_blank" rel="noopener">
                Repository →
              </a>
            </p>
          </article>
        ))
      }

      <details class="more">
        <summary class="more__summary">
          {rest.length} more projects: data pipelines, machine learning, undergraduate archive
        </summary>
        {
          rest.map((p) => (
            <article class="proj">
              <div class="proj__head">
                <h3>{p.title}</h3>
                <span class="chip">{p.kind}</span>
              </div>
              <p class="proj__summary">{p.summary}</p>
              <p class="num">
                <a href={p.repo} target="_blank" rel="noopener">
                  Repository →
                </a>
              </p>
            </article>
          ))
        }
      </details>
    </section>

    <section class="section" id="outside">
      <div class="section-head">
        <span class="section-head__num">5.6</span>
        <h2>Outside the lab</h2>
      </div>
      <p>
        I swam competitively, and it shaped how I work more than any course did: measure honestly,
        adjust continuously, and stay consistent long enough for it to compound. Reasonable training
        for reliability engineering, where nothing interesting happens quickly.
      </p>
      <DraftNote
        needs="One honest paragraph about what you are reading, learning, or arguing about lately. This does more for a personal site than another list of tools — your 19,000-impression LinkedIn post was written in exactly this register."
      />
    </section>
  </div>
</Base>

<style>
  /* Desktop: prose left, photo right. Phones collapse to source order —
     name and role first, then the photo, then the rest — so the page opens
     with who she is rather than with a portrait. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    grid-template-areas: 'lead aside' 'body aside';
    gap: 0 clamp(2rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-bottom: 1rem;
    align-items: start;
  }

  .intro__lead {
    grid-area: lead;
  }

  .intro__body {
    grid-area: body;
  }

  .intro__aside {
    grid-area: aside;
  }

  .intro__lede {
    margin-top: 1.25rem;
    font-size: var(--fs-lede);
  }

  .intro h1 {
    margin-bottom: 0;
  }

  .intro__photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: 1rem;
  }

  .intro__links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .section-head__sub {
    margin: 0.5rem 0 0;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  /* This is a reference page, not a landing page: tighter vertical rhythm
     than the essays so the whole record stays scannable. */
  .about :global(.section) {
    padding-block: clamp(2rem, 4.5vw, 3.25rem);
  }

  /* The contents block keeps a long page navigable. */
  .contents {
    margin-top: 2rem;
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius);
    background: var(--paper-sunk);
  }

  .contents__title {
    margin: 0 0 0.75rem;
  }

  .contents__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    font-size: var(--fs-small);
  }

  .contents__list li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }

  /* entries (experience, education, certifications) */
  .entries {
    max-width: 52rem;
  }

  .exp__note {
    margin: 0.35rem 0 0;
  }

  /* Certifications are short: two columns on a wide screen. */
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    column-gap: 2.5rem;
    max-width: none;
  }

  /* skills: area on the left, one readable line on the right */
  .skills {
    margin: 0;
    max-width: 52rem;
    border-top: 1px solid var(--rule);
  }

  .skills__row {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    gap: 0.35rem 1.5rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--rule);
  }

  .skills__area {
    font-weight: 600;
    font-size: var(--fs-small);
  }

  .skills__items {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .skills__sep {
    color: var(--rule-strong);
  }

  /* projects */
  .proj {
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule);
  }

  .proj__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .proj__summary {
    margin-bottom: 0.75rem;
  }

  .proj__detail {
    margin: 0 0 0.85rem;
    padding-left: 1.15rem;
    max-width: var(--measure);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .more {
    border-top: 1px solid var(--rule);
  }

  .more__summary {
    cursor: pointer;
    padding-block: 1.1rem;
    font-family: var(--font-sans);
    font-size: var(--fs-meta);
    color: var(--accent);
  }

  .more__summary:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .more[open] .more__summary {
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.5rem;
  }

  .more .proj:first-of-type {
    border-top: 0;
  }

  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
      grid-template-areas: 'lead' 'aside' 'body';
      gap: 1.5rem 0;
    }

    .intro__aside {
      max-width: 13rem;
    }
  }

  @media (max-width: 40rem) {
    .skills__row {
      grid-template-columns: 1fr;
    }

    .certs {
      grid-template-columns: 1fr;
    }
  }
</style>
