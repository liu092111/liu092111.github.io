---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** A raster figure. Omit it and pass the figure as children instead, e.g.
   *  an inline SVG drawn with `var(--ink)` etc., which inherits the design
   *  tokens and so stays correct in both colour schemes. `alt` goes with `src`. */
  src?: ImageMetadata;
  alt?: string;
  caption: string;
  /** Figure number, e.g. "2.1". Rendered as `FIG 2.1`. */
  no: string;
  /** Break out of the text measure for wide or photographic figures. */
  wide?: boolean;
  /** Where the figure comes from, printed as "Ref:" under the caption.
   *  `href` links the DOI or source page. */
  source?: { text: string; href?: string };
}

const { src, alt, caption, no, wide = false, source } = Astro.props;
---

<figure class:list={['fig', wide && 'fig--wide']}>
  <div class="fig__frame">
    {
      src ? (
        <Image
          src={src}
          alt={alt ?? ''}
          widths={[480, 800, 1280]}
          sizes={wide ? '(max-width: 50rem) 100vw, 60rem' : '(max-width: 32rem) 100vw, 32rem'}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <slot />
      )
    }
  </div>
  <figcaption class="fig__cap">
    <span class="label fig__no">Fig {no}</span>
    <span>
      {caption}
      {
        source && (
          <span class="fig__ref">
            Ref:{' '}
            {source.href ? (
              <a href={source.href} target="_blank" rel="noopener">
                {source.text} ↗
              </a>
            ) : (
              source.text
            )}
          </span>
        )
      }
    </span>
  </figcaption>
</figure>

<!-- Inline SVG charts draw their curves when scrolled into view: the data
     arrives left to right, the way it was measured, then the markers and
     notes that read off it fade in. Only the data curves move; axes,
     reference lines and the key are there from the start.
     Inline and synchronous, right after its own figure, so the curves are
     hidden before first paint even when the chart is on screen at load (a
     tall window, or a chart near the top), and it still draws in. Same
     pattern as the home page count-up. No JavaScript or no
     IntersectionObserver: the chart is simply complete. Plays under reduced
     motion too: a line extending in place moves nothing (see the motion
     policy in global.css). -->
<script is:inline>
  (() => {
    const fig = document.currentScript && document.currentScript.previousElementSibling;
    const svg = fig && fig.querySelector('svg.chart');
    const lines = svg ? svg.querySelectorAll('polyline.chart__line') : [];
    if (!lines.length || !('IntersectionObserver' in window)) return;
    // pathLength="1" makes every curve one unit long, so one dash rule
    // draws them all at the same pace whatever their real length.
    lines.forEach((line) => {
      line.setAttribute('pathLength', '1');
      line.classList.add('chart__draw');
    });
    svg.classList.add('is-pending');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        // Two frames: let the hidden state paint once, so the draw is a
        // transition rather than an instant jump to the finished curve.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => svg.classList.remove('is-pending'))
        );
      },
      { threshold: 0.5 }
    );
    io.observe(svg);
  })();
</script>

<style>
  /* Narrower than the text and centred under it: a figure supports the
     prose around it and should not outweigh it on a laptop screen. */
  .fig {
    margin: 2rem auto;
    max-width: 32rem;
  }

  .fig--wide {
    max-width: 60rem;
  }

  /* Rounded rather than framed: an outline around a photo adds a box the
     eye has to parse without adding information. */
  .fig__frame {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-sunk);
    line-height: 0;
  }

  .fig__frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .fig__cap {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    padding-top: 0.6rem;
    font-size: var(--fs-meta);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .fig__ref {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fs-label);
  }

  .fig__no {
    flex: none;
    color: var(--accent);
  }
</style>
