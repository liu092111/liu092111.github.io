---
/**
 * Why acceleration stops buying you units, drawn as inline SVG so it inherits
 * the design tokens: correct in both colour schemes, no binary asset, no JS.
 *
 * The curve is the real relation, not a sketch: a zero-failure plan needs
 * n = ln(1-C)/ln(R) units, and an acceleration factor divides that by AF. So
 * required units fall as 1/AF. Plotted as a fraction of the unaccelerated
 * sample rather than as counts, because the ratio is the transferable part and
 * the absolute number belongs to whichever programme set R and C.
 *
 * The argument is the intersection. Below a practical floor of about three
 * units a single failure reads as a 33% failure rate, so the claim collapses
 * whatever the statistics said. Past that crossing, more acceleration is free
 * margin, not fewer units.
 */

/* Geometry kept in one place so the curve and its annotations cannot drift.
   AF 1 to 10 maps across the plot; y is the fraction of the unaccelerated
   sample, 1 at the top. */
const X0 = 96;
const X1 = 620;
const Y_TOP = 50;
const Y_BASE = 236;
const AF_MAX = 10;

const x = (af: number) => X0 + ((af - 1) / (AF_MAX - 1)) * (X1 - X0);
const y = (frac: number) => Y_BASE - frac * (Y_BASE - Y_TOP);

/* Three units out of a nineteen-unit unaccelerated plan is the ratio at which
   the floor bites. Expressed as a fraction for the same reason as above. */
const FLOOR = 3 / 19;
const floorY = y(FLOOR);
const crossAF = 1 / FLOOR;
const crossX = x(crossAF);

// Sampled finely enough that the knee reads as a curve rather than a corner.
const steps = 60;
const curve = Array.from({ length: steps + 1 }, (_, i) => {
  const af = 1 + (i / steps) * (AF_MAX - 1);
  return `${x(af).toFixed(1)},${y(1 / af).toFixed(1)}`;
}).join(' ');
---

<svg
  class="floor"
  viewBox="0 0 660 300"
  role="img"
  aria-labelledby="floor-title floor-desc"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="floor-title">Acceleration reduces sample size until a practical floor takes over</title>
  <desc id="floor-desc">
    Required units fall in inverse proportion to the acceleration factor, steeply at first and then
    barely at all. A horizontal floor marks roughly three units, below which one failure reads as a
    thirty-three percent failure rate. The curve meets that floor at an acceleration factor of about
    six, after which further acceleration reduces no units and only adds margin.
  </desc>

  <!-- axes -->
  <g stroke="var(--rule-strong)" stroke-width="1">
    <line x1={X0} y1={Y_TOP - 8} x2={X0} y2={Y_BASE} />
    <line x1={X0} y1={Y_BASE} x2={X1 + 20} y2={Y_BASE} />
  </g>

  <!-- where the binding constraint changes hands -->
  <line
    x1={crossX}
    y1={Y_TOP - 8}
    x2={crossX}
    y2={Y_BASE}
    stroke="var(--rule)"
    stroke-width="1"
    stroke-dasharray="3 4"
  />

  <!-- the practical floor: not a statistical result, a consequence of having
       too few units for any failure to be survivable -->
  <line
    x1={X0}
    y1={floorY}
    x2={X1 + 20}
    y2={floorY}
    stroke="var(--signal)"
    stroke-width="1.5"
    stroke-dasharray="6 4"
  />

  <polyline points={curve} fill="none" stroke="var(--ink)" stroke-width="2.5" />

  <!-- the two regimes -->
  <g font-family="var(--font-mono)" font-size="15">
    <text x={X0 + 14} y={Y_TOP + 26} fill="var(--ink)">statistics sets n</text>
    <text x={crossX + 14} y={Y_TOP + 26} fill="var(--ink-muted)">the floor sets n</text>
    <text x={X1 + 20} y={floorY - 10} text-anchor="end" fill="var(--signal)">
      practical floor · one failure reads as 33%
    </text>
  </g>

  <!-- axis labels -->
  <g font-family="var(--font-mono)" font-size="11" letter-spacing="1.4" fill="var(--ink-muted)">
    <text x={X0} y={Y_TOP - 18}>UNITS, AS A FRACTION OF THE UNACCELERATED PLAN</text>
    <text x={X1 + 20} y={Y_BASE + 26} text-anchor="end">ACCELERATION FACTOR →</text>
    <text x={X0 - 6} y={Y_TOP + 4} text-anchor="end">1</text>
    <text x={X0 - 6} y={Y_BASE + 4} text-anchor="end">0</text>
  </g>

  <text
    x={X0 + 14}
    y={Y_BASE - 14}
    font-family="var(--font-mono)"
    font-size="12"
    fill="var(--ink-muted)">n = ln(1 − C) / ln(R), divided by AF</text
  >
</svg>

<style>
  .floor {
    display: block;
    width: 100%;
    height: auto;
    padding: 1.25rem 1.25rem 0.75rem;
  }
</style>
