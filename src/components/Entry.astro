---
/**
 * One résumé entry with the organisation's logo beside it, in the shape a
 * LinkedIn profile uses: logo, then organisation, role and dates, then detail.
 * Used for experience, education and certifications on About, so all three
 * scan the same way.
 *
 * The logo is decorative (alt=""): the organisation's name is always the
 * heading right next to it, so announcing it twice would only add noise.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  logo: ImageMetadata;
  heading: string;
  /** Optional link on the heading, e.g. a credential's verification page. */
  href?: string;
  /** Role, degree or issuer: the line under the heading. */
  sub?: string;
  period?: string;
  /** Tighter spacing for short entries such as certifications. */
  compact?: boolean;
}

const { logo, heading, href, sub, period, compact = false } = Astro.props;
---

<article class:list={['entry', compact && 'entry--compact']}>
  <Image class="logo entry__logo" src={logo} alt="" width={96} height={96} loading="lazy" />
  <div class="entry__main">
    <header class="entry__head">
      <div>
        <h3 class="entry__heading">
          {href ? (
            <a href={href} target="_blank" rel="noopener">
              {heading}
            </a>
          ) : (
            heading
          )}
        </h3>
        {sub && <p class="entry__sub">{sub}</p>}
      </div>
      {period && <p class="num entry__period">{period}</p>}
    </header>
    <slot />
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.1rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--rule);
  }

  .entry--compact {
    padding-block: 1.1rem;
  }

  /* Base logo treatment (size, rounding, no frame) is the global `.logo`. */

  .entry__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    flex-wrap: wrap;
  }

  .entry__heading {
    font-size: 1.1875rem;
  }

  .entry__heading a {
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 0.2em;
  }

  .entry__sub {
    margin: 0.2rem 0 0;
    font-size: var(--fs-small);
    color: var(--ink);
  }

  .entry__period {
    margin: 0;
    white-space: nowrap;
  }

  .entry__main :global(ul) {
    margin: 0.85rem 0 0;
    padding-left: 1.15rem;
    max-width: var(--measure);
    font-size: var(--fs-small);
  }

  .entry__main :global(li) {
    margin-bottom: 0.4rem;
  }

  .entry__main :global(p:not([class])) {
    margin: 0.7rem 0 0;
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  @media (max-width: 34rem) {
    .entry {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.85rem;
    }

    .entry :global(.entry__logo) {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
